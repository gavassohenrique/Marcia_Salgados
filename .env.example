# Configuração da infraestrutura (não inclua senhas de usuários aqui).
# Copie para .env e altere as credenciais antes de iniciar o sistema.
POSTGRES_USER=user
POSTGRES_DB=appdb
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_DO_BANCO
FLASK_SECRET_KEY=SUBSTITUA_POR_STRING_ALEATORIA_DE_64_CARACTERES
# Usuários são criados no PostgreSQL pelo comando:
# docker compose exec backend python manage.py criar-admin

# Recuperação por e-mail: origem pública obrigatoriamente HTTPS, sem caminho.
PUBLIC_APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
